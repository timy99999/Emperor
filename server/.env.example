# Copy this file to .env and fill in real values. .env is gitignored.

PORT=8743

# bcrypt hash of the admin panel password. Generate with:
#   npm run hash-password -- "your-password-here"
ADMIN_PASSWORD_HASH=

# Any long random string, used to sign the admin session JWT.
SESSION_SECRET=

# --- Only needed when frontend and backend run on different domains (Vercel + Railway) ---

# The deployed frontend's exact origin, no trailing slash. Required for CORS.
# FRONTEND_ORIGIN=https://imperator.vercel.app

# true switches the admin session cookie to SameSite=None; Secure, which cross-site
# requests need. Leave unset for local dev (http://localhost).
# COOKIE_SECURE=true

# Path to the JSON data file. Point this at a mounted Railway volume so likes/
# suggestions survive redeploys, e.g. /data/data.json.
# DATA_FILE=/data/data.json
